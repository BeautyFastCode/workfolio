{% import 'shared/twig/_macros/analytics.html.twig' as analytics %}

<turbo-frame id="{{ turboFrame.contactFormId }}">
    <div class="contact-form card mt-5 text-start">
        <div class="card-body p-4 p-md-5">

            {{ form_start(form) }}

            {{ form_row(form.fullName) }}
            {{ form_row(form.email) }}
            {{ form_row(form.subject) }}
            {{ form_row(form.message) }}

            <button type="submit"
                    class="btn btn-lg text-uppercase w-100"
                {{ analytics.track_click('contact_form_submit') }}
            >
                {{ 'contact_message.submit'|trans }}
            </button>

            {{ form_end(form) }}
        </div>
    </div>
</turbo-frame>
