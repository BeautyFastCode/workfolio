
{% extends 'shared/layout/base.html.twig' %}

{% block title %}{{ status_code }} - {{ status_text }}{% endblock %}

{% block body %}
    <div class="container">
        <div class="row min-vh-100 align-items-center justify-content-center">
            <div class="col-md-8 col-lg-6 text-center">

                <div class="display-1 text-accent">{{ status_code }}</div>

                <h1 class="mb-3">{{ status_text }}</h1>

                <p class="mb-4">{{ 'errors.404'|trans }}</p>

                <div class="d-flex justify-content-center gap-2">
                    <a href="{{ path('app_home') }}" class="btn btn-secondary">{{ 'errors.return_to_home'|trans }}</a>
                </div>

            </div>
        </div>
    </div>

    <script>
        document.documentElement.setAttribute('data-bs-theme', 'dark');
    </script>

{% endblock %}
