{
    "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120
    },
    "linter": {
        "enabled": true
    },
    "files": {
        "includes": [
            "assets/**/*.js",
            "assets/**/*.css",
            "!assets/vendor/**",
            "!assets/stimulus_bootstrap.js"
        ]
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always",
            "arrowParentheses": "asNeeded"
        }
    },
    "css": {
        "formatter": {
            "quoteStyle": "single"
        }
    }
}
